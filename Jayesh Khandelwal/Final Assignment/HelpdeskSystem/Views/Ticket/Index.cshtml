@model List<HelpdeskSystem.Models.Ticket>

@{
    ViewData["Title"] = "Tickets";
}

<div class="ticket-container">

    <div class="ticket-header">
        <h2>Tickets</h2>
        <p>All the Tickets</p>
    </div>

    <form asp-action="Index" method="get" class="ticket-filters">

        <select name="status" class="filter-input">
            <option value="">All Status</option>
            <option value="New" selected="@(ViewBag.Status == "New")">New</option>
            <option value="Assigned" selected="@(ViewBag.Status == "Assigned")">Assigned</option>
            <option value="InProgress" selected="@(ViewBag.Status == "InProgress")">In Progress</option>
            <option value="Resolved" selected="@(ViewBag.Status == "Resolved")">Resolved</option>
            <option value="Closed" selected="@(ViewBag.Status == "Closed")">Closed</option>
        </select>
        @if (User.IsInRole("CompanyAdmin") || User.IsInRole("Agent"))
        {
            <select name="assignee" class="filter-input">
                <option value="">All Assignees</option>
                @foreach (var agent in ViewBag.Agents)
                {
                    <option value="@agent.Id" selected="@(ViewBag.Assignee == agent.Id)">
                        @agent.Email
                    </option>
                }
            </select>
        }
        <select name="priority" class="filter-input">
            <option value="">All Priority</option>
            <option value="High" selected="@(ViewBag.Priority == "High")">High</option>
            <option value="Medium" selected="@(ViewBag.Priority == "Medium")">Medium</option>
            <option value="Low" selected="@(ViewBag.Priority == "Low")">Low</option>
        </select>

        <input type="text" name="search" class="filter-input"placeholder="Search..." value="@ViewBag.Search" />

        <select name="sort" class="filter-input">
            <option value="">Newest</option>
            <option value="oldest" selected="@(ViewBag.Sort == "oldest")">Oldest</option>
        </select>

        <label class="overdue-option">
            <input type="checkbox"
                   name="overdue"
                   value="true"
                   checked="@(ViewBag.Overdue)" />
            Overdue
        </label>

        <button type="submit" class="filter-button">
            Filter
        </button>

    </form>

    @if (Model.Count == 0)
    {
        <div class="no-tickets">
            No tickets found.
        </div>
    }
    else
    {
        <div class="ticket-grid">

            @foreach (var ticket in Model)
            {
                <div class="ticket-card">

                    <h3>@ticket.Title</h3>

                    <p class="ticket-description">
                        @ticket.Description
                    </p>

                    <p>
                        <strong>Priority:</strong>
                        @ticket.Priority
                    </p>

                    <p>
                        <strong>Status:</strong>
                        @ticket.Status
                    </p>
                    @if ((!ticket.FirstRespondedAt.HasValue &&  ticket.FirstResponseDue < DateTime.Now) ||
                         (ticket.Status != TicketStatus.Resolved &&
                          ticket.Status != TicketStatus.Closed &&
                          ticket.ResolutionDue < DateTime.Now))
                    {
                        <span class="ticket-overdue">
                            Overdue
                        </span>
                    }
                    <p>
                        <strong>Created:</strong>
                        @ticket.CreatedAt.ToString("dd-MM-yyyy")
                    </p>
                    <div class="ticket-buttons">
                        <a asp-controller="Ticket" asp-action="Details" asp-route-id="@ticket.Id" class="ticket-button">
                            Details
                        </a>

                        @if (ticket.AssignedToUserId == null && ticket.Status != TicketStatus.Closed)
                        {
                            <a asp-controller="Ticket" asp-action="Edit"asp-route-id="@ticket.Id" class="ticket-button">
                                Edit
                            </a>
                        }

                        @if (User.IsInRole("CompanyAdmin"))
                        {
                            <form asp-controller="Ticket" asp-action="Delete"asp-route-id="@ticket.Id" method="post">
                                <button type="submit" class="ticket-button">
                                    Delete
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
       </div>
        <div class="pagination">

            @if (ViewBag.Page > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.Page - 1)"
                   asp-route-status="@ViewBag.Status"
                   asp-route-priority="@ViewBag.Priority"
                   asp-route-search="@ViewBag.Search"
                   asp-route-sort="@ViewBag.Sort"
                   asp-route-overdue="@ViewBag.Overdue"
                   class="ticket-button">
                    Previous
                </a>
            }

            <span>Page @ViewBag.Page</span>

            @if (Model.Count == 10)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.Page + 1)"
                   asp-route-status="@ViewBag.Status"
                   asp-route-priority="@ViewBag.Priority"
                   asp-route-search="@ViewBag.Search"
                   asp-route-sort="@ViewBag.Sort"
                   asp-route-overdue="@ViewBag.Overdue"
                   class="ticket-button">
                    Next
                </a>
            }

        </div>
    }
</div>
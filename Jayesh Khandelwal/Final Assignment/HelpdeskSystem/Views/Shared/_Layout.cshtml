<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HelpdeskSystem</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HelpdeskSystem.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"  asp-area="" asp-controller="Dashboard" asp-action="Index">
                    HelpdeskSystem
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("CompanyAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Ticket" asp-action="Index">
                                        Tickets
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"asp-controller="Ticket" asp-action="CreateTicket">
                                        Create Ticket
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="User" asp-action="ManageUser">
                                        Manage Users
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Agent"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Ticket"
                                       asp-action="Index">
                                        Tickets
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Ticket" asp-action="CreateTicket">
                                        Create Ticket
                                    </a>
                                </li>

                            }
                            else if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Ticket"
                                       asp-action="Index">
                                        My Tickets
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Ticket"
                                       asp-action="CreateTicket">
                                        Create Ticket
                                    </a>
                                </li>
                            }
                        }

                    </ul>   
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="notification-area">

                            <a href="#" id="notificationBell"  class="notification-link" title="Notifications">
                                <img src="~/images/notification-bell.png" alt="Notifications" class="notification-icon">
                                <span id="notificationCount" class="notification-count">
                                    0
                                </span>
                            </a>
                            <div id="notificationPanel" class="notification-panel">
                                <div class="notification-header">
                                    Notifications
                                </div>

                                <div id="notificationList" class="notification-list">
                                    <div class="no-notifications">
                                        No new notifications
                                    </div>
                                </div>

                            </div>
                        </div>
                        <form asp-controller="Account"asp-action="Logout" method="post">
                            <button type="submit" class="btn">Logout </button>
                        </form>                      
                    }
                    else
                    {
                        <a asp-controller="Account"asp-action="Login" class="btn">
                            Login
                        </a>

                        <a asp-controller="Account" asp-action="Register" class="btn">
                            Register
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ticket.js"></script>
    <script src="~/js/notification.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>